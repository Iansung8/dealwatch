# 複製成 .env 再填。.env 不會進版控，不要上傳或分享。

# --- LINE 推播（設定步驟見 README「LINE 推播」）---
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
# 只推給你自己：LINE Developers Console > Basic settings 最下方的 "Your user ID"（U 開頭 33 碼）。留空 = 廣播給所有好友
LINE_TO=

# --- 其他推播（可與 LINE 並用；設定步驟見 README「其他推播管道」）---
DISCORD_WEBHOOK=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NTFY_TOPIC=

# --- 以下只有 Docker / NAS 部署會用到 ---

# 網頁介面和遠端瀏覽器畫面共用的密碼。開放給區域網路時務必設定。
UI_PASSWORD=
# 遠端瀏覽器畫面的登入帳號（網頁介面的帳號欄隨便填）
VIEW_USER=dealwatch

# NAS 對外的埠號
# 預設只聽 NAS 本機；部署時改成 NAS 的區網或 VPN（ZeroTier、Tailscale 等）IPv4。
HOST_BIND_IP=127.0.0.1
HOST_UI_PORT=8787
HOST_VIEW_PORT=3001
# Chromium 實機驗收後可填固定 tag 或 digest，更新前先驗證。
CHROMIUM_IMAGE=linuxserver/chromium:latest
# Chromium 設定檔與快取放哪裡（預設 ./data/browser）。NAS 有 SSD 儲存空間時建議指過去，例如 /volume2/docker/dealwatch-browser；
# 資料夾要先建好、擁有者是 PUID／PGID，搬移時先停專案再整個複製過去。
BROWSER_CONFIG_DIR=

# 檔案擁有者。在 NAS 上用 SSH 執行 `id 你的帳號` 查；Synology 第一個管理員通常是 1026 / 100
PUID=1026
PGID=100

TZ=America/Chicago

# 部署時想蓋過 config.mjs 的設定、又不想改 config.mjs：取消註解再填。ZIP_CODE 設成空的 = 不限定取貨地點
# ZIP_CODE=
# BESTBUY_INTERVAL_SEC=180
# WALMART_INTERVAL_SEC=600
# WOOT_INTERVAL_SEC=120
# NEWEGG_INTERVAL_SEC=300
# SLICKDEALS_INTERVAL_SEC=180
# REDDIT_INTERVAL_SEC=120
